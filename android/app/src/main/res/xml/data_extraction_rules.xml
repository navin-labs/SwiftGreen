<?xml version="1.0" encoding="utf-8"?>
<!-- API 31+. Same rule as backup_rules.xml: the pairing key never leaves the device,
     by cloud backup or by device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="swiftgreen_pairing.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="swiftgreen_pairing.xml"/>
    </device-transfer>
</data-extraction-rules>
